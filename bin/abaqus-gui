#!/usr/bin/env bash
# abaqus-gui: open the Abaqus VM desktop in an RDP window (no sudo).
# Starts the VM if off, waits for SSH, brings the license VPN up, runs xfreerdp3 as user abaqus.
# The password is read from <state_dir>/admin-password and goes to xfreerdp3 on stdin (/args-from:stdin),
# never on a command line. In the session, start "Abaqus CAE (mesa)" from the desktop
# (abaqus cae -mesa; qxl video has no 3D). One-time VM setup: ./setup.sh gui
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
eval "$(uv run --directory "$HERE" python -m abaqus_mcp.config --print)"
USER_=abaqus
PWFILE="$STATE_DIR/admin-password"
SSH=(ssh -F "$STATE_DIR/ssh_config" -o BatchMode=yes -o ConnectTimeout=3 "$SSH_HOST")
VIRSH=(virsh -c qemu:///session)

[ -s "$PWFILE" ] || { echo "abaqus-gui: $PWFILE missing" >&2; exit 1; }
command -v xfreerdp3 >/dev/null || { echo "abaqus-gui: xfreerdp3 not installed" >&2; exit 1; }

"${VIRSH[@]}" domstate "$VM_NAME" | grep -q running || { echo "starting $VM_NAME"; "${VIRSH[@]}" start "$VM_NAME" >/dev/null; }

for _ in $(seq 1 90); do
    "${SSH[@]}" cmd /c ver >/dev/null 2>&1 && break
    sleep 2
done
"${SSH[@]}" cmd /c ver >/dev/null 2>&1 \
    || { echo "abaqus-gui: no SSH on $VM_NAME after 3 min" >&2; exit 1; }

"$HERE/bin/abaqus-vpn" up

# /dynamic-resolution follows the window size; +clipboard shares the clipboard;
# /cert:ignore: self-signed VM cert, reached through a forward on 127.0.0.1.
{ printf '%s\n' /v:127.0.0.1:"$RDP_PORT" /u:"$USER_" /title:"Abaqus VM" /dynamic-resolution \
        +clipboard +auto-reconnect /cert:ignore /sec:nla -wallpaper -themes /network:lan
  printf '/p:%s\n' "$(head -n1 "$PWFILE")"; } | exec xfreerdp3 /args-from:stdin
