#!/usr/bin/env bash
# abaqus-vpn up|down|status: wraps the NetworkManager connection named by vpn_connection in the
# config (default fs-abaqus; no sudo).
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
eval "$(uv run --directory "$HERE" python -m abaqus_mcp.config --print)" || exit 1
CON="$VPN_CONNECTION"

active() { nmcli -t -f NAME connection show --active | grep -qx "$CON"; }

case "${1:-}" in
    up)     active || nmcli connection up "$CON" >/dev/null || exit 1
            echo "$CON: up" ;;
    down)   active && { nmcli connection down "$CON" >/dev/null || exit 1; }
            echo "$CON: down" ;;
    status) if active; then echo "$CON: up"; else echo "$CON: down"; exit 3; fi ;;
    *)      echo "usage: abaqus-vpn up|down|status" >&2; exit 2 ;;
esac
